# ==============================================================================
# LLM Cost Autopilot Engine - Environment Configuration (.env)
# Copy this file to .env in your root project folder when running in VS Code.
# ==============================================================================

# LLM Provider API Keys (Set any or all of your real API keys below)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Tier Default Models
# Easy Tier Default: Gemini 3.5 Flash-Lite (Google)
EASY_MODEL="gemini-3.5-flash-lite"

# Medium Tier Default: Claude Sonnet 5 (Anthropic)
MEDIUM_MODEL="claude-sonnet-5"

# Hard Tier Default: GPT-5.6 Sol (OpenAI)
HARD_MODEL="gpt-5.6-sol"

# Routing Optimization Strategy: "balanced" | "cost" | "quality" | "latency"
OPTIMIZATION_STRATEGY="balanced"

# Mode configuration: "false" for Live API execution, "true" for simulation fallback
DEMO_MODE="false"

# Application URL (optional, defaults to http://localhost:3000)
APP_URL=""



